{
  "manifest_version": 3,
  "name": "KUDM Integration",
  "version": "0.3.0",
  "description": "Send downloads and detected videos to KUDM (KUbuntu Download Manager).",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "webRequest",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KUDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kudm@kudm.local",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}